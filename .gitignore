# signing keys — private key must never be committed
.tauri/*.key
# keep .pub files (public key is safe to commit)

# large binaries — never commit these
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm

# large images
*.png

# environment / secrets
.env
.env.*
!.env.example

# scratch / temp
scratch/
launcher_err.txt
launcher_out.txt
vite.config.ts.timestamp-*
release-portable/

# sdks / runtimes
sdks/
shardx-launcher/runtime/
