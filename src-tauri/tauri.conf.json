{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opinion Insights Browser",
  "version": "2.1.0",
  "identifier": "com.opinioninsights.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Opinion Insights Browser",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "startMenuFolder": "Opinion Insights Browser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNUEzNjc0QUQ3ODkwNEEKUldSS2tIaXRkRFphMHk3NGJBRy81Tm5Jb2QySlFPOFNUek01MzlqSHFsQVJsYVgrRlBPWk82VkcK",
      "endpoints": [
        "https://github.com/shivamks0909/antidetect-tool/releases/latest/download/latest.json"
      ]
    }
  }
}
